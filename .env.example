# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
SHOW_SWAGGER=true

# ---- Database (PostgreSQL) ----
# For local dev these match docker-compose (compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sprintboard
DB_PASSWORD=sprintboard
DB_NAME=sprintboard
# Auto-create/update schema from entities. Keep true only in development.
DB_SYNCHRONIZE=true
# Optional: a full connection string (used by hosted DBs like Neon/Supabase).
# When set, it takes precedence over the discrete DB_* vars above.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ---- Firebase Admin (service account, for verifying auth tokens) ----
# Firebase console: Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n newlines exactly as in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Cloudinary (used to validate evidence URLs) ----
CLOUDINARY_CLOUD_NAME=kpurw60m

# ---- Email (invitations, password recovery, email change) ----
# true -> everything goes to Mailpit, the local inbox from compose.yml
# (`docker compose up -d mailpit`): nothing leaves, read it at
# http://localhost:8026. false or unset -> the real provider in EMAIL_PROVIDER.
IS_EMAIL_MOCKED=true
MAILPIT_URL=smtp://localhost:1026
# Host ports of Mailpit, if they clash with another project (keep MAILPIT_URL in sync).
# MAILPIT_SMTP_PORT=1026
# MAILPIT_UI_PORT=8026

# Real provider: `smtp` (Brevo, Gmail or any SMTP server) or `ses` (Amazon SES
# through the AWS API). Both can stay configured: this one wins.
EMAIL_PROVIDER=smtp

# Sender for any provider: an address that provider has verified.
MAIL_FROM="Kanbio <kanbiosprint@gmail.com>"

# SMTP (EMAIL_PROVIDER=smtp).
# Brevo: dashboard -> SMTP & API. The password is the SMTP key, not the API key.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# Gmail: an app password of the sending Google account (never the real one).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kanbiosprint@gmail.com
SMTP_PASSWORD=your-smtp-password

# Amazon SES (EMAIL_PROVIDER=ses).
# AWS_REGION=sa-east-1
# Credentials, all optional (with none: the instance/task IAM role).
# Only for testing by hand, not in prod:
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# To assume a role other than the instance one (AssumeRole):
# SES_ROLE_ARN=
# SES_ROLE_SESSION_NAME=kanbio
# Public web URL used to generate invitation links.
WEB_URL=http://localhost:3000
# Shared expiration for Kanbio invitation and email-change links.
LINK_EXPIRATION_HOURS=24
