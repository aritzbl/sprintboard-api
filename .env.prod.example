# .env of the production VM (/home/ec2-user/.env), read by compose.prod.yml.
# compose.prod.yml passes each container only what it uses; see DEPLOY.md.

# ---- Images (deploy.sh rewrites these; :latest = newest build of main) ----
IMAGE_API=ghcr.io/aritzbl/sprintboard-api:latest
IMAGE_WEB=ghcr.io/aritzbl/sprintboard-web:latest

# ---- Domain and Cloudflare (Caddy certificate + update-dns.sh) ----
# Web and API share it: the web calls the API at /api. Also sets WEB_URL and
# CORS_ORIGIN of the API (https://SITE_ADDRESS).
SITE_ADDRESS=kanbio.yourdomain.com
CF_ZONE_ID=
CF_API_TOKEN=

# ---- PostgreSQL (container on the VM; never leaves it) ----
# Same major version as the database you restore from (Neon: SHOW server_version).
POSTGRES_VERSION=17
POSTGRES_USER=kanbio
POSTGRES_PASSWORD=
POSTGRES_DB=kanbio

# ---- Firebase Admin (service account; keep the quotes and the literal \n) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Object storage (S3). No keys: the instance's IAM role is used ----
S3_BUCKET=kanbio-files
S3_REGION=sa-east-1
S3_KEY_PREFIX=prod
S3_PUBLIC_BASE_URL=https://kanbio-files.s3.sa-east-1.amazonaws.com

# ---- Email ----
# true -> the VM's Mailpit (nothing leaves; ssh -L 8026:localhost:8025 to read it).
IS_EMAIL_MOCKED=false
EMAIL_PROVIDER=smtp
MAIL_FROM="Kanbio <kanbiosprint@gmail.com>"
# Brevo: dashboard -> SMTP & API -> SMTP (the password is the SMTP key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Only for EMAIL_PROVIDER=ses (also through the instance role):
# AWS_REGION=sa-east-1
# SES_ROLE_ARN=

# ---- Optional ----
# LINK_EXPIRATION_HOURS=24
# API_NODE_OPTIONS=--max-old-space-size=384
# WEB_NODE_OPTIONS=--max-old-space-size=256
